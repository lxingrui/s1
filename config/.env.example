# =============================================================================
# 环境变量 / 密钥配置模板
# -----------------------------------------------------------------------------
# 复制为 config/.env 后填入真实值：
#   cp config/.env.example config/.env
# 运行脚本会自动 source config/.env（不要把它提交到 git！）
# =============================================================================

# ---------------------------- 打分模型（自定义端点）---------------------------
# 任何兼容 OpenAI /chat/completions 的服务都可以
GRADING_BASE_URL="https://api.deepseek.com/v1"
GRADING_API_KEY="sk-xxxxxxxxxxxxxxxx"
GRADING_MODEL="deepseek-chat"

# ---------------------------- HuggingFace ----------------------------
# runpod 上把缓存放到数据盘，避免容器重启后重下
HF_HOME="/workspace/hf_cache"
HF_HUB_ENABLE_HF_TRANSFER="1"
# 国内网络可换成镜像： https://hf-mirror.com
# HF_ENDPOINT="https://hf-mirror.com"
# 私有模型/数据集需要 token
# HUGGING_FACE_HUB_TOKEN="hf_xxxxxxxxxxxxxxxx"

# ---------------------------- 飞书机器人 ----------------------------
FEISHU_WEBHOOK="https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx"
FEISHU_SECRET="xxxxxxxxxxxxxxxx"

# ---------------------------- 实验控制 ----------------------------
# 输出目录（config.yaml 会用 ${S1_OUTPUT_DIR} 读取）
S1_OUTPUT_DIR="/workspace/outputs"
# 每个 task 最多评测多少条（留空表示用 config.yaml 里的值）
# S1_LIMIT="30"
