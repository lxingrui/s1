# =============================================================================
# 环境变量 / 密钥配置模板
# -----------------------------------------------------------------------------
# 复制为 config/.env 后填入真实值：
#   cp config/.env.example config/.env
# 运行脚本会自动 source config/.env（不要把它提交到 git！）
# =============================================================================

# ---------------------------- 打分模型（自定义端点）---------------------------
# 任何兼容 OpenAI /chat/completions 的服务都可以
GRADING_BASE_URL="https://api.deepseek.com/v1"
GRADING_API_KEY="sk-xxxxxxxxxxxxxxxx"
GRADING_MODEL="deepseek-chat"

# ---------------------------- HuggingFace ----------------------------
# runpod 上把缓存放到数据盘，避免容器重启后重下
HF_HOME="/workspace/hf_cache"
HF_HUB_ENABLE_HF_TRANSFER="1"
# 注意：启用上面那行需要安装 hf_transfer（--install 会自动补装）。
# 不想装就把它注释掉，否则 huggingface_hub 会直接报错。
# 国内网络可换成镜像： https://hf-mirror.com
# HF_ENDPOINT="https://hf-mirror.com"
# 私有模型/数据集需要 token
# HUGGING_FACE_HUB_TOKEN="hf_xxxxxxxxxxxxxxxx"

# ---- 云端网络卷（RunPod Global Volume / FUSE.GEESEFS）----
# 这类文件系统不支持 POSIX 符号链接，HF 缓存里的软链接会变成 0 字节死链，
# 导致分词器的 config.json 读取时报 JSONDecodeError。
# 设为 1 可让 HF 直接复制实体文件（本地 NVMe 上无需设置；
# run_eval.sh 会自动检测网络文件系统并开启）。
# HF_HUB_DISABLE_SYMLINKS="1"

# ---------------------------- 飞书机器人 ----------------------------
# 注意：这里只放占位符，真实值请填在你本地的 config/.env（已被 .gitignore 忽略）
FEISHU_WEBHOOK="https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx"
FEISHU_SECRET="xxxxxxxxxxxxxxxx"

# ---------------------------- 实验控制 ----------------------------
# 输出目录（config.yaml 会用 ${S1_OUTPUT_DIR} 读取）
S1_OUTPUT_DIR="/workspace/outputs"
# 每个 task 最多评测多少条（留空表示用 config.yaml 里的值）
# S1_LIMIT="30"
# 并行策略覆盖（data / tensor），留空则以 config.yaml 的 model.parallel 为准
# S1_PARALLEL="data"
